{
  "installCommand": "",
  "framework": null,
  "functions": {
    "api/rex.rs": {
      "runtime": "@vercel/rust@1.3.0",
      "maxDuration": 30,
      "includeFiles": ""
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Server-Timing",
          "value": "test;dur=1"
        },
        {
          "key": "x-Server-Timing",
          "value": "test;dur=2"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/rex"
    }
  ]
}